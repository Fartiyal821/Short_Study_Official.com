{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Standard study course module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string" },
        "paymentLink": { "type": "string" }
      }
    },
    "Post": {
      "title": "Post",
      "description": "Lesson post or article",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "courseId": { "type": "string" }
      }
    },
    "PaidCourse": {
      "title": "PaidCourse",
      "description": "Paid premium course offering",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "videoEmbed": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "CourseOrder": {
      "title": "CourseOrder",
      "description": "Student enrollment or order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "studentPhone": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "amount": { "type": "string" },
        "utr": { "type": "string" },
        "utrNumber": { "type": "string" },
        "screenshotURL": { "type": "string" },
        "purchased": { "type": "boolean" },
        "isPurchased": { "type": "boolean" },
        "status": { "type": "string" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Payment proof order submitted by student",
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhone": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "amount": { "type": "string" },
        "utrNumber": { "type": "string" },
        "screenshotURL": { "type": "string" },
        "status": { "type": "string" },
        "isPurchased": { "type": "boolean" },
        "purchased": { "type": "boolean" },
        "uid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userName", "userEmail", "userPhone", "courseId", "utrNumber", "screenshotURL", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Courses collection"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Posts and lessons collection"
    },
    "/paid_courses/{courseId}": {
      "schema": { "$ref": "#/entities/PaidCourse" },
      "description": "Paid courses collection"
    },
    "/course_orders/{orderId}": {
      "schema": { "$ref": "#/entities/CourseOrder" },
      "description": "Course enrollment orders collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders collection containing payment proof and UTR"
    }
  }
}
