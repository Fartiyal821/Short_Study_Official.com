rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read, write on paid_courses
    match /paid_courses/{courseId} {
      allow read, write: if true;
    }

    // Allow read, write on courses
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Allow read, write on posts
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Allow read, write on lessons
    match /lessons/{lessonId} {
      allow read, write: if true;
    }

    // Allow read, write on course_orders
    match /course_orders/{orderId} {
      allow read, write: if true;
    }

    // Allow read, write on course_access
    match /course_access/{accessId} {
      allow read, write: if true;
    }

    // Allow read, write on admins
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
